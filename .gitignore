# Track the maintained source distribution, not the entire research workspace.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/AGENTS.md
!/.github/
!/ai_baseon_c/
!/docs/

# Local-only research archive: publish the portable docs/ guide instead.
/ai_baseon_c/docs/guide.md

# Reproducible build products and developer caches.
**/build/
**/Debug/
**/Release/
**/CMakeFiles/
**/CMakeCache.txt
**/compile_commands.json
**/__pycache__/
**/*.py[cod]
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.elf
**/*.map
**/*.list
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/Thumbs.db
/ai_baseon_c/model/generated/

# Model checkpoints and recordings stay local; committed examples are synthetic.
**/*.pth
**/*.pt
**/*.onnx
**/*.tflite
**/*.wav
**/*.mp3
**/*.flac

# Optional historical board/experiment tools are not the public application.
/ai_baseon_c/tools/f446_studio/
/ai_baseon_c/tools/speaker_benchmark/
/ai_baseon_c/tools/speaker_refinement/
/ai_baseon_c/tools/speaker_performance/
/ai_baseon_c/tools/speaker_diagnostics_firmware/
/ai_baseon_c/tools/speaker_diagnostic_board.py
/ai_baseon_c/tests/python/test_speaker_*.py
/ai_baseon_c/tests/python/test_kernel_refinement.py
/ai_baseon_c/tests/python/test_f446_studio_*.py
/ai_baseon_c/tests/python/test_studio_optimization.py

# Host-local maintenance helpers may mention the private F446 workspace.
/ai_baseon_c/tools/build_f446.ps1
/ai_baseon_c/tools/flash_f446.ps1
/ai_baseon_c/tools/benchmark_f446_cnn.py

# Explicit public developer tools; historical orchestration stays local.
/ai_baseon_c/tools/*
!/ai_baseon_c/tools/model_converter/
!/ai_baseon_c/tools/model_studio/
/ai_baseon_c/tools/model_studio/board_matrix.py
!/ai_baseon_c/tools/speaker_benchmark/
/ai_baseon_c/tools/speaker_benchmark/*
!/ai_baseon_c/tools/speaker_benchmark/__init__.py
!/ai_baseon_c/tools/speaker_benchmark/activation_reference.py
!/ai_baseon_c/tools/configure_make.py
!/ai_baseon_c/tools/convert_model.py
!/ai_baseon_c/tools/library_sources.py
!/ai_baseon_c/tools/model_studio_gui.py
!/ai_baseon_c/tools/train_models.py
!/ai_baseon_c/tools/verify_models.py
!/ai_baseon_c/tools/verify_cnn_model.py
!/ai_baseon_c/tools/test_robustness.py
!/ai_baseon_c/tools/test_platform_matrix.py
!/ai_baseon_c/tools/verify_arm_backends.py
!/ai_baseon_c/tools/check_repository.py
!/ai_baseon_c/tools/generate_example_models.py
!/ai_baseon_c/tools/plot_benchmark_report.py

/ai_baseon_c/tests/python/*
!/ai_baseon_c/tests/python/test_model_*.py
/ai_baseon_c/tests/python/test_model_studio_board_matrix.py
!/ai_baseon_c/tests/python/test_weight_cache_converter.py
!/ai_baseon_c/tests/python/test_repository_tools.py
!/ai_baseon_c/tests/python/test_public_report.py

/ai_baseon_c/model/*
!/ai_baseon_c/model/rnn_params.npz
!/ai_baseon_c/model/lstm_params.npz

# Publish only the curated documentation surface and its small aggregate assets.
/docs/*
!/docs/README.md
!/docs/guide.md
!/docs/benchmark_report.md
!/docs/project_layout.md
!/docs/assets/
