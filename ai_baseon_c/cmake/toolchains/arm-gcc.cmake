# Shared bare-metal GNU Arm toolchain. A board project still supplies startup,
# a linker script, clock/interrupt setup and its C runtime.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    NN_CPU NN_ARCH_BITS NN_TOOLCHAIN_PREFIX NN_FLOAT_ABI NN_FPU)
set(NN_CPU "cortex-m4" CACHE STRING "Compiler CPU target")
set(NN_ARCH_BITS "32" CACHE STRING "Arm execution state: 32 or 64")

if(NN_ARCH_BITS STREQUAL "64")
    set(NN_TOOLCHAIN_PREFIX "aarch64-none-elf-" CACHE STRING "Compiler path/prefix")
    set(nn_target_flags "-mcpu=${NN_CPU}")
elseif(NN_ARCH_BITS STREQUAL "32")
    set(NN_TOOLCHAIN_PREFIX "arm-none-eabi-" CACHE STRING "Compiler path/prefix")
    set(NN_FLOAT_ABI "hard" CACHE STRING "soft, softfp or hard; must match board/runtime")
    if(NOT NN_FLOAT_ABI MATCHES "^(soft|softfp|hard)$")
        message(FATAL_ERROR "NN_FLOAT_ABI must be soft, softfp or hard")
    endif()
    if(NN_CPU MATCHES "^cortex-m")
        set(nn_target_flags "-mcpu=${NN_CPU} -mthumb -mfloat-abi=${NN_FLOAT_ABI}")
    else()
        set(nn_target_flags "-mcpu=${NN_CPU} -marm -mfloat-abi=${NN_FLOAT_ABI}")
    endif()
    set(NN_FPU "fpv4-sp-d16" CACHE STRING "FPU/NEON target, or none")
    if(NOT NN_FPU STREQUAL "none")
        string(APPEND nn_target_flags " -mfpu=${NN_FPU}")
    elseif(NOT NN_FLOAT_ABI STREQUAL "soft")
        message(FATAL_ERROR "NN_FPU=none requires NN_FLOAT_ABI=soft")
    endif()
else()
    message(FATAL_ERROR "NN_ARCH_BITS must be 32 or 64")
endif()

if(IS_ABSOLUTE "${NN_TOOLCHAIN_PREFIX}")
    if(CMAKE_HOST_WIN32)
        set(nn_tool_suffix ".exe")
    else()
        set(nn_tool_suffix "")
    endif()
    set(CMAKE_C_COMPILER "${NN_TOOLCHAIN_PREFIX}gcc${nn_tool_suffix}")
    set(CMAKE_AR "${NN_TOOLCHAIN_PREFIX}ar${nn_tool_suffix}")
    set(CMAKE_RANLIB "${NN_TOOLCHAIN_PREFIX}ranlib${nn_tool_suffix}")
else()
    find_program(CMAKE_C_COMPILER NAMES "${NN_TOOLCHAIN_PREFIX}gcc" REQUIRED)
    find_program(CMAKE_AR NAMES "${NN_TOOLCHAIN_PREFIX}ar" REQUIRED)
    find_program(CMAKE_RANLIB NAMES "${NN_TOOLCHAIN_PREFIX}ranlib" REQUIRED)
endif()
set(CMAKE_SYSTEM_PROCESSOR "${NN_CPU}")
set(CMAKE_C_FLAGS_INIT "${nn_target_flags} -ffunction-sections -fdata-sections")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
